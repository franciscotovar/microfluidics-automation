; PROTOTYPE ONLY — unvalidated in uProcess 2.x.
; Does not control pumps. Calibrate sensor-to-fluid mapping and targets.
*4AM01 = 4AM01
*P12159 = uPS01 800 kPa
*P22200 = uPS01 800 kPa

Setup:
    log(on)
    Target_P1 = 20
    Target_P2 = 10
    Tolerance = 0.05
    CV_limit = 0.05
    Window_s = 2
    Sampling_ms = 100
    N = Window_s * 1000 / Sampling_ms
    Stable = 0

Monitor:
    Sum1 = 0
    Sum2 = 0
    SumSq1 = 0
    SumSq2 = 0
    i = 0
    t_start = scripttime()
    While (i < N)
    {
        P1 = P12159.Reading
        P2 = P22200.Reading
        Sum1 = Sum1 + P1
        Sum2 = Sum2 + P2
        SumSq1 = SumSq1 + P1^2
        SumSq2 = SumSq2 + P2^2
        i = i + 1
        Wait(Sampling_ms ms)
    }
    Actual_Window_s = scripttime() - t_start
    Mean1 = Sum1 / N
    Mean2 = Sum2 / N
    Std1 = sqrt(max(0, SumSq1/N - Mean1^2))
    Std2 = sqrt(max(0, SumSq2/N - Mean2^2))
    CV1 = Std1 / max(abs(Mean1), 0.001)
    CV2 = Std2 / max(abs(Mean2), 0.001)
    OK1 = (abs(Mean1-Target_P1) <= abs(Target_P1)*Tolerance)
    OK2 = (abs(Mean2-Target_P2) <= abs(Target_P2)*Tolerance)
    OK3 = (CV1 <= CV_limit)
    OK4 = (CV2 <= CV_limit)
    If (OK1)
    {
        If (OK2)
        {
            If (OK3)
            {
                If (OK4)
                {
                    Goto Stable_Check
                }
            }
        }
    }
    Stable = 0
    Goto Monitor

Stable_Check:
    If (Stable == 0)
    {
        Beep()
        Stable = 1
    }
    Goto Monitor
